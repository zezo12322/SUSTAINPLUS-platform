# ==========================================
# SUSTAINPLUS PLATFORM - Environment Variables
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to version control
# ==========================================

# --- Database (PostgreSQL / Supabase) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sustainplus_platform?schema=public"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# --- Anthropic (Claude AI) ---
# Required for AI consultations. Leave blank to activate safe fallback mode.
ANTHROPIC_API_KEY="sk-ant-..."

# Model routing (override defaults if needed)
ANTHROPIC_SIMPLE_MODEL="claude-haiku-4-5-20251001"
ANTHROPIC_COMPLEX_MODEL="claude-sonnet-4-6"

# --- Paymob (Payment Gateway) ---
PAYMOB_API_KEY="your_paymob_api_key"
PAYMOB_HMAC_SECRET="your_paymob_hmac_secret"
PAYMOB_IFRAME_ID="your_iframe_id"
PAYMOB_INTEGRATION_ID_CARD="your_card_integration_id"
PAYMOB_INTEGRATION_ID_WALLET="your_wallet_integration_id"

# --- App ---
NEXT_PUBLIC_PLATFORM_URL="http://localhost:3001"
NEXT_PUBLIC_MAIN_SITE_URL="http://localhost:3000"
# Set to "true" to enable AI fallback mode when API key is missing
NEXT_PUBLIC_AI_FALLBACK_MODE="false"

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE="20"

# --- Admin ---
# Email of the initial admin user (set during seed)
ADMIN_EMAIL="admin@sustainplus-eg.com"
ADMIN_PASSWORD="change-this-immediately"
