# Debug screenshots — only root-level PNGs (leading slash = root only, so
# public/**/*.png assets are NOT ignored). Never commit debug screenshots.
/*.png

# Local operational scripts may contain secrets — keep the dir ignored.
# scripts/start.js is force-tracked (production `npm start` entrypoint).
/scripts/

# Scratch logo assets
/public/_logos/
/public/_logocheck.html

# TestSprite scaffolding (local only)
testsprite_tests/

# Migration secrets (local only — NEVER commit)
/scripts/.migration.env
/scripts/*.secret
